#VRML V2.0 utf8
# RV1106 "Core1106" Linux SoM stand-in: a dark SBC carrier with a metal RF/CPU can on top.
# KiCad's renderer reads VRML units as 0.1 inch (2.54 mm), so all sizes below are the mm target
# divided by 2.54 (footprint is ~25.5 mm square). Origin at board surface, +Z up.
Shape {
  appearance Appearance { material Material { diffuseColor 0.05 0.14 0.07 specularColor 0.05 0.05 0.05 shininess 0.15 } }
  geometry Box { size 10.04 10.04 0.63 }
}
Transform {
  translation 0 0 0.67
  children [
    Shape {
      appearance Appearance { material Material { diffuseColor 0.34 0.35 0.38 specularColor 0.3 0.3 0.3 shininess 0.5 } }
      geometry Box { size 5.9 7.1 0.94 }
    }
  ]
}
