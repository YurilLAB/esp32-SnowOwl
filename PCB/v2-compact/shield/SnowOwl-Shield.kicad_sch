    (comment 1 "ESP32-SnowOwl v2 - compact 2-board stack"))
  (lib_symbols)
  (text "ESP32-SnowOwl v2  --  SHIELD.  ESP32-C5 (centre) MASTERS the SPI spine; every SPI radio taps off it. The S3 does NOT touch the radios; it commands the C5 over one UART on J1. Antennas on edges. I2C -> PN532. Big modules (nRF24 x3, RV1106) on the BACK. See PLACEMENT.md." (at 20 15 0)
    (effects (font (size 1.4 1.4)) (justify left top)) (uuid bbbb0000-0000-4000-8000-000000000001))
